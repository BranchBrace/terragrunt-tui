<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifeste du paquet MSIX publié sur le Microsoft Store (scripts/package-msix.ps1).
  Identity : valeurs réservées dans Partner Center pour « ttui for Terragrunt ».
  Version : remplacée à l'empaquetage par X.Y.Z.0 (le Store impose 4 parties, la dernière à 0).
  Application console : le menu Démarrer ouvre une console, et les alias d'exécution mettent
  `terragrunt-tui` et `ttui` dans le PATH de tout terminal.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop4 rescap">

  <Identity
    Name="AntoineMonnier.ttuiforTerragrunt"
    Publisher="CN=94794141-B9ED-4FA9-B74B-C1FC94E6B207"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>ttui for Terragrunt</DisplayName>
    <PublisherDisplayName>Antoine Monnier</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="fr-FR" />
  </Resources>

  <Applications>
    <Application
      Id="ttui"
      Executable="terragrunt-tui.exe"
      EntryPoint="Windows.FullTrustApplication"
      desktop4:Subsystem="console"
      desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="ttui for Terragrunt"
        Description="Revue locale et en lecture seule des plans Terragrunt, dans le terminal."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension
          Category="windows.appExecutionAlias"
          Executable="terragrunt-tui.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="terragrunt-tui.exe" />
            <uap5:ExecutionAlias Alias="ttui.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
