# Revue d'un résultat sauvegardé : régénérer avec `bash docs/demo/record.sh` depuis la racine du dépôt.
Output docs/demo/review.gif

Set Shell "powershell"
Set FontSize 16
Set Width 1400
Set Height 760
Set Padding 16
Set TypingSpeed 60ms

Hide
Type "cls; ./target/release/ttui.exe show --run docs/specs/fixtures/demo-run.json"
Enter
Sleep 4s
Show
Sleep 1.5s
Down
Sleep 500ms
Down
Sleep 500ms
Down
Sleep 1.2s
Tab
Sleep 1.5s
Down
Sleep 1s
Tab
Sleep 2.5s
Type "d"
Sleep 3s
Type "d"
Sleep 1s
Escape
Sleep 800ms
Escape
Sleep 1s
Type "/"
Sleep 500ms
Type "app"
Sleep 800ms
Enter
Sleep 2.5s
Type "q"
Sleep 500ms
